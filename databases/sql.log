CREATE TABLE `area`(
    `id` INT AUTO_INCREMENT NOT NULL,
    `nombre` VARCHAR(512) NOT NULL,
    `padre` INT  , INDEX `padre__idx` (`padre`), FOREIGN KEY (`padre`) REFERENCES `area` (`id`) ON DELETE NO ACTION,
    `nivel` INT  , INDEX `nivel__idx` (`nivel`), FOREIGN KEY (`nivel`) REFERENCES `nivel` (`id`) ON DELETE CASCADE,
    `rol_key` VARCHAR(512),
    PRIMARY KEY (`id`)
) ENGINE=InnoDB CHARACTER SET utf8;
